{
  "$schema": "https://json.schemastore.org/wrangler.json",
  "name": "ton-observatory-template-example",
  "main": "src/index.mjs",
  "compatibility_date": "2026-11-17",
  "triggers": {
    "crons": [
      "*/10 * * * *"
    ]
  },
  "keep_vars": true,
  "observability": {
    "enabled": true
  }
}
